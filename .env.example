# Placeholder contract only. Generate independent secrets in a managed secret store.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/openfront_hospital_disposable
SESSION_SECRET=local-only-session-secret-replace-via-openssl-rand-hex-32
BOOTSTRAP_ADMIN_SECRET=local-only-bootstrap-admin-secret-replace-via-openssl-rand-hex-32
PASSWORD_RESET_PEPPER=local-only-password-reset-pepper-replace-via-openssl-rand-hex-32
AUTH_RATE_LIMIT_PEPPER=local-only-auth-rate-limit-pepper-replace-via-openssl-rand-hex-32
INTAKE_DELIVERY_SIGNING_KEY=local-only-intake-delivery-signing-key-replace-via-openssl-rand-hex-32
OUTBOX_WORKER_SECRET=local-only-outbox-worker-secret-replace-via-openssl-rand-hex-32
INTEGRATION_SECRET_ENCRYPTION_KEY=replace-with-32-bytes-as-64-hex-characters
EXPORT_ENCRYPTION_KEY=replace-with-different-32-bytes-as-64-hex-characters

# Credential-free canonical HTTPS public origin.
SMTP_STORE_LINK=https://hospital.example.test
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Hospital operations <no-reply@example.test>

S3_BUCKET_NAME=replace-me
S3_REGION=replace-me
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_ENDPOINT=https://object-storage.example.test

# Comma-separated exact outbound integration hosts.
INTEGRATION_HOST_ALLOWLIST=integrations.example.test
TRUST_PROXY=0
TRUST_PROXY_HOPS=0

# Configure only in the separate worker service.
OUTBOX_WORKER_URL=https://hospital.example.test/api/internal/outbox/dispatch
OUTBOX_WORKER_INTERVAL_SECONDS=60
