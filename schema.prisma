  appliedIds        Json?
  actorReference    String    @default("")
  appliedAt         DateTime?
  rolledBackAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([facilityId])
}

model ExportJob {
  id                String    @id @default(cuid())
  jobNumber         String    @unique @default("")
  exportType        String
  status            String    @default("queued")
  transitionVersion Int       @default(1)
  operationKeyHash  String    @unique @default("")
  requestHash       String    @default("")
  facility          Facility  @relation("ExportJob_facility", fields: [facilityId], references: [id])
  facilityId        String    @map("facility")
  requestedBy       User      @relation("ExportJob_requestedBy", fields: [requestedById], references: [id])
  requestedById     String    @map("requestedBy")
  format            String
  filters           Json?
  objectKey         String    @default("")
  resultDigest      String    @default("")
  accessTokenDigest String    @default("")
  resultCiphertext  String    @default("")
  resultIv          String    @default("")
  resultTag         String    @default("")
  actorReference    String    @default("")
  expiresAt         DateTime
  readyAt           DateTime?
  consumedAt        DateTime?
  errorCode         String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([facilityId])
  @@index([requestedById])
}

model ExternalIdentityLink {
  id               String   @id @default(cuid())
  linkNumber       String   @unique @default("")
  facility         Facility @relation("ExternalIdentityLink_facility", fields: [facilityId], references: [id])
  facilityId       String   @map("facility")
  system           String   @default("")
  resourceType     String   @default("")
  externalId       String   @default("")
  localType        String   @default("")
  localId          String   @default("")
  status           String   @default("active")
  operationKeyHash String   @unique @default("")
  requestHash      String   @default("")
  actorReference   String   @default("")
  createdAt        DateTime @default(now())

  @@unique([facilityId, system, resourceType, externalId], map: "ExternalIdentityLink_external_key")
  @@index([facilityId])
  @@index([localId])
}

model RequestRateLimitBucket {
  id        String   @id @default(cuid())
  startedAt DateTime
  count     Int
  updatedAt DateTime

  @@index([updatedAt])
}

model PasswordResetRequest {
  id               String    @id @default(cuid())
  tokenDigest      String    @unique @default("")
  accountDigest    String    @default("")
  status           String    @default("pending")
  user             User      @relation("PasswordResetRequest_user", fields: [userId], references: [id])
  userId           String    @map("user")
  expiresAt        DateTime
  mailSentAt       DateTime?
  redeemedAt       DateTime?
  supersededAt     DateTime?
  deliveryFailedAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([accountDigest])
  @@index([status])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, status, expiresAt], map: "PasswordResetRequest_user_status_expiry_idx")
}
